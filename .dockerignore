# Everything the build does not read. Keeping the context small is why a
# rebuild takes seconds: node_modules alone is larger than the repository.
.git
.github
bin
web/node_modules
web/dist
internal/web/dist
.playwright-mcp
.dev
docs
*.md
!README.md

# The binary imports github.com/fuseone/agents/docs, and that package embeds
# only docs/manual. Keep the rest of docs/ out of the image context while still
# letting the package compile inside Docker.
!docs/
!docs/*.go
!docs/manual/
!docs/manual/**
